# Copy to .env.local and fill in. Never commit real values — secret scanning
# and push protection are on, but don't rely on them.

# Neon connection string. For local work use a Neon dev branch seeded with
# synthetic data (npm run db:seed), never the production branch.
DATABASE_URL=

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# One-time token that lets the first passkey be registered on a fresh
# database; ignored once any passkey exists. 24+ characters.
# Generate with: openssl rand -base64 32
OWNER_SETUP_TOKEN=

# Production only: pin passkeys to the real domain. Leave unset locally and
# on previews, where they're derived from the request.
# WEBAUTHN_RP_ID=ledger.example.com
# WEBAUTHN_ORIGIN=https://ledger.example.com

# Encrypts bank-connection credentials (the SimpleFIN access URL) at rest.
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Losing or changing it makes stored connections unreadable — reconnect them.
CONNECTION_ENCRYPTION_KEY=

# Vercel Cron sends this as a bearer token to /api/cron/sync; anything else
# is rejected. 16+ characters. Generate with: openssl rand -base64 32
CRON_SECRET=

# Data Diary sends this as a bearer token to the read-only bridge
# (/api/bridge/v1/…, docs/bridge-v1.md). Set the same value in Data Diary.
# Unset or under 32 characters turns the bridge off.
# Generate with: openssl rand -base64 32
BRIDGE_TOKEN=

# Push notifications (#29). Generate the pair once with:
#   npx web-push generate-vapid-keys
# The public key is given to browsers when they subscribe; the private key
# signs every push and never leaves the server. Changing them invalidates
# every device's subscription (turn notifications on again on each).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@example.com or an https URL
# (Apple rejects localhost).
VAPID_SUBJECT=
